{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everyone-s-kitchen",
  "main": "worker.js",
  "compatibility_date": "2026-09-12",
  "keep_vars": true,
  "kv_namespaces": [
    { "binding": "SITE_CONTENT_V2" }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  }
}
